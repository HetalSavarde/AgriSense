# Rename this file to .env and fill in your key before running the server.
# NOTE: the API contract doc specifies ANTHROPIC_API_KEY. If detection/chat/recovery
# text generation actually uses Gemini instead, rename this to GOOGLE_API_KEY and
# update app/config.py + the three services accordingly. Keep this consistent
# across the whole team so no one is debugging a "missing key" error that's
# actually a "wrong key name" error.
ANTHROPIC_API_KEY=sk-ant-your-key-here
